# Обязательно
TELEGRAM_TOKEN=123456789:AA...

# Кому доступны /stats и служебные команды (ID через запятую)
ADMIN_IDS=123456789

# Необязательные ограничения
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
MAX_UPLOAD_MB=48
MAX_HEIGHT=1080
MAKE_THUMBNAIL=1
MAX_DURATION_SEC=600
MAX_CONCURRENT_JOBS=1
MAX_QUEUE=10
MAX_LINKS_PER_MESSAGE=3
# ALLOWED_HOSTS=youtube.com,youtu.be,instagram.com,instagr.am,tiktok.com

# Прокси для YouTube/Instagram, если сервер заблокирован платформой
# PROXY_URL=http://user:password@host:port

# Адрес для self-ping, чтобы Render free не засыпал (на Render подставляется сам)
# KEEPALIVE_URL=https://your-service.onrender.com
# KEEPALIVE_INTERVAL_SEC=600

# Cookies в формате Netscape (экспорт из браузера). Можно задать файлом или base64:
# COOKIES_FILE=C:\path\to\cookies.txt
# COOKIES_B64=<base64 от cookies.txt>

FFMPEG_PRESET=ultrafast
LOG_LEVEL=INFO
WORK_DIR=/tmp/shorts-video-bot
PORT=8080
